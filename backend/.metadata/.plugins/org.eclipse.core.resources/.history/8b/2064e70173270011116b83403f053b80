package com.nexorcrm.backend.validation;

import com.nexorcrm.backend.util.PhoneValidationUtil;
import jakarta.validation.ConstraintValidator;
import jakarta.validation.ConstraintValidatorContext;
import java.lang.reflect.Field;

public class PhoneNumberValidator implements ConstraintValidator<ValidPhoneNumber, String> {

    private String countryCodeFieldName;

    @Override
    public void initialize(ValidPhoneNumber constraintAnnotation) {
        this.countryCodeFieldName = constraintAnnotation.countryCodeFieldName();
    }

    @Override
    public boolean isValid(String phone, ConstraintValidatorContext context) {
        // If phone is null or empty, it's optional - use @NotBlank if required
        if (phone == null || phone.isBlank()) {
            return true;
        }

        // Try to get the country code from the bean being validated
        String countryCode = null;
        try {
            Object bean = context.getRootBeanInstance();
            if (bean != null) {
                Field ccField = bean.getClass().getDeclaredField(countryCodeFieldName);
                ccField.setAccessible(true);
                Object ccValue = ccField.get(bean);
                countryCode = ccValue != null ? ccValue.toString() : "+91";
            }
        } catch (NoSuchFieldException | IllegalAccessException e) {
            // Field not found, use default
            countryCode = "+91";
        }

        if (countryCode == null || countryCode.isBlank()) {
            countryCode = "+91";
        }

        // Validate phone number
        String errorMessage = PhoneValidationUtil.validatePhoneNumber(phone, countryCode);

        if (!errorMessage.isEmpty()) {
            context.disableDefaultConstraintViolation();
            context.buildConstraintViolationWithTemplate(errorMessage)
                    .addConstraintViolation();
            return false;
        }

        return true;
    }
}
